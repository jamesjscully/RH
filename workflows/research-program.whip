workflow RHResearchProgram

class ResearchWorkItem {
  title string
  body string
  route "lean" | "math" | "numerics" | "review" | "log"
  status "queued" | "done"
  priority int
}

class ResearchResult {
  title string
  route string
  summary string
  status "recorded"
}

agent lean_worker {
  profile "repo-writer"
  capacity 1
}

agent math_worker {
  profile "repo-reader"
  capacity 1
}

agent numerics_worker {
  profile "repo-writer"
  capacity 1
}

agent reviewer {
  profile "repo-reader"
  capacity 1
}

rule seed_initial_research_work
  when started
=> {
  record ResearchWorkItem {
    title "Formalize abstract contradiction mechanism"
    body "Strengthen RH.Strategy.ContradictionMechanism so the hypothetical zero predicate, forward convergence, reverse obstruction, and positive gap are explicit structured hypotheses."
    route "lean"
    status "queued"
    priority 1
  }

  record ResearchWorkItem {
    title "Derive half-plane Gram matrix target"
    body "Work out the finite Gram matrix and target vector for the Hardy half-plane module witness spaces V_N(tau), including the exact norm convention to use."
    route "math"
    status "queued"
    priority 1
  }

  record ResearchWorkItem {
    title "Plan finite Gram numerical experiments"
    body "Design scripts for computing candidate Gram matrices, condition numbers, and scaling behavior as tau approaches 1/2."
    route "numerics"
    status "queued"
    priority 2
  }
}

rule dispatch_lean_work
  when ResearchWorkItem as item where item.status == "queued" && item.route == "lean"
  when lean_worker is available
=> {
  tell lean_worker as turn """
  Work on this Lean formalization task for the RH witness-constraint program.

  Title:
  {{ item.title }}

  Body:
  {{ item.body }}

  Preserve research logs and run lake build RH before reporting completion.
  """

  after turn succeeds {
    done item

    record ResearchResult {
      title item.title
      route item.route
      summary turn.summary
      status "recorded"
    }
  }
}

rule dispatch_math_work
  when ResearchWorkItem as item where item.status == "queued" && item.route == "math"
  when math_worker is available
=> {
  tell math_worker as turn """
  Work on this mathematical derivation for the RH witness-constraint program.

  Title:
  {{ item.title }}

  Body:
  {{ item.body }}

  Produce theorem candidates, assumptions, and exact dependencies for the research log.
  """

  after turn succeeds {
    done item

    record ResearchResult {
      title item.title
      route item.route
      summary turn.summary
      status "recorded"
    }
  }
}

rule dispatch_numerics_work
  when ResearchWorkItem as item where item.status == "queued" && item.route == "numerics"
  when numerics_worker is available
=> {
  tell numerics_worker as turn """
  Work on this numerical experiment design for the RH witness-constraint program.

  Title:
  {{ item.title }}

  Body:
  {{ item.body }}

  Keep scripts reproducible and clearly separate exploratory numerics from certified theorem targets.
  """

  after turn succeeds {
    done item

    record ResearchResult {
      title item.title
      route item.route
      summary turn.summary
      status "recorded"
    }
  }
}

rule review_recorded_results
  when ResearchResult as result where result.status == "recorded"
  when reviewer is available
=> {
  tell reviewer """
  Review this RH research result and identify follow-up work, risks, and missing verification.

  Title:
  {{ result.title }}

  Route:
  {{ result.route }}

  Summary:
  {{ result.summary }}
  """
}
